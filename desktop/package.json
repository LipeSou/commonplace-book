{
  "name": "commonplace-desktop",
  "productName": "Commonplace Book",
  "version": "0.1.0",
  "private": true,
  "description": "Commonplace Book — desktop (Electron + Vue)",
  "author": "Felipe",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "electron .",
    "icon": "node build/make-icon.mjs",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.felipe.commonplacebook",
    "productName": "Commonplace Book",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Commonplace Book"
    }
  },
  "//": "tudo abaixo é dependência de build: o Vite embute o renderer (Vue, CodeMirror, fontes) no dist/, e o processo Electron só usa APIs nativas. Nada disso precisa ir pro pacote — por isso são todas devDependencies.",
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.5",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/shippori-mincho": "^5.2.8",
    "@fontsource/zen-kaku-gothic-new": "^5.2.7",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "vite": "^6.3.0",
    "vue": "^3.5.0",
    "wait-on": "^8.0.0"
  }
}
